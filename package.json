{
  "name": "preparcial-usuarios-roles",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --env-file=.env dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "lint:fix": "oxlint --type-aware --fix src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:run": "nest build && node --env-file=.env node_modules/typeorm/cli.js migration:run -d dist/database/data-source.js",
    "migration:revert": "nest build && node --env-file=.env node_modules/typeorm/cli.js migration:revert -d dist/database/data-source.js",
    "migration:generate": "node scripts/migration-generate.mjs",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run migration:run && npm run db:seed",
    "db:seed": "docker compose exec -T db psql -q -U preparcial -d preparcial_db -v ON_ERROR_STOP=1 < sql/03_usuarios_y_roles_de_prueba.sql",
    "db:psql": "docker compose exec db psql -U preparcial -d preparcial_db",
    "role": "node --env-file=.env scripts/dev.mjs role",
    "user": "node --env-file=.env scripts/dev.mjs user",
    "token": "node --env-file=.env scripts/dev.mjs token"
  },
  "dependencies": {
    "@nestjs/authentication": "^0.1.7",
    "@nestjs/authorization": "^0.1.4",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
